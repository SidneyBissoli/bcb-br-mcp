// Configuração do Worker bcb-br-mcp — instância do template de hosting da Fase 0.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // ATENÇÃO: o nome do worker é "bcb" desde a origem, e é ele que determina o
  // hostname workers.dev (https://bcb.sidneybissoli.workers.dev). Renomear para
  // "bcb-br-mcp" criaria um worker NOVO e mataria a URL que os usuários atuais
  // já apontam. O nome fica; o domínio próprio abaixo é o endpoint primário.
  "name": "bcb",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,

  // Domínio próprio (padrão do portfólio) — endpoint MCP público:
  // https://bcb.sidneybissoli.com/mcp. O hostname também está em
  // SERVER_CONFIG.extraAllowedHostnames (src/config.ts) — o createMcpHandler valida Host.
  "routes": [{ "pattern": "bcb.sidneybissoli.com", "custom_domain": true }],

  "vars": {
    "ALLOWED_ORIGIN": "*"
  },

  // Estatísticas de uso — Durable Object singleton com storage SQLite (src/usage.ts).
  // Nenhum recurso precisa ser criado manualmente: a migration abaixo provisiona a classe no deploy.
  // Este servidor nunca teve telemetria por tool; a série começa do zero aqui.
  "durable_objects": {
    "bindings": [{ "name": "USAGE", "class_name": "UsageTracker" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["UsageTracker"] }],

  // Telemetria de tool calls — tool/desfecho/país/AS/marcador self por chamada,
  // consultável via SQL API do Analytics Engine. O dataset é criado no primeiro
  // writeDataPoint. Esquema (privacy-scoped) em src/analytics.ts.
  "analytics_engine_datasets": [
    { "binding": "ANALYTICS", "dataset": "bcb_mcp_tool_calls" }
  ],

  // Metadados do último deploy (id/tag/timestamp) — expostos em GET /status para que
  // a liveness e o build corrente sejam verificáveis sem o handshake MCP.
  "version_metadata": { "binding": "CF_VERSION_METADATA" },

  // Logs estruturados no painel da Cloudflare (Workers Logs).
  "observability": { "enabled": true }
}
